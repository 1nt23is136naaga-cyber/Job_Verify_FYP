{
  "manifest_version": 3,
  "name": "ScamShield AI Job Scam Detector",
  "version": "3.2",
  "description": "AI powered job scam detector for LinkedIn, Indeed, and Naukri. Identifies risk patterns in postings using Gemini AI.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://mail.google.com/*",
    "*://*.internshala.com/*",
    "*://*.naukri.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.onrender.com/*",
    "https://*.railway.app/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://mail.google.com/*",
        "*://*.internshala.com/*",
        "*://*.naukri.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
