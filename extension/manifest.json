{
  "manifest_version": 3,
  "name": "ScamShield — AI Job Scam Detector",
  "version": "2.1",
  "description": "AI-powered job scam detector for LinkedIn, Gmail, Internshala & Naukri. Powered by Gemini 2.0 Flash.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "*://www.linkedin.com/*",
    "*://mail.google.com/*",
    "*://internshala.com/*",
    "*://www.naukri.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.linkedin.com/*",
        "*://mail.google.com/*",
        "*://internshala.com/*",
        "*://www.naukri.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}
